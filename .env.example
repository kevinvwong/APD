# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5   # optional; any current claude-* model

# Neon Postgres — https://console.neon.tech/
# Use the pooled URL for app queries, unpooled for drizzle-kit migrations
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Retrieval backend — "json" (default, build-safe), "pg" (Postgres full-text),
# or "hybrid" (keyword + pgvector semantic search). pg/hybrid need fm_sections
# populated; hybrid also needs the pgvector migration + embeddings.
# RETRIEVE_BACKEND=hybrid

# Embeddings (only for RETRIEVE_BACKEND=hybrid). Default provider is OpenAI
# (text-embedding-3-small, 1536-d). Set EMBED_PROVIDER=voyage to use Voyage AI.
# Dimension must match drizzle/0002_pgvector.sql.
# OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=...
# EMBED_PROVIDER=openai
# EMBED_MODEL=text-embedding-3-small
